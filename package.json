{
  "name": "ai-timeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run data && vite",
    "data": "node scripts/build-data.mjs",
    "validate": "node scripts/build-data.mjs --check",
    "build": "npm run data && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:groups": "npm run build && node scripts/groups.browser.mjs",
    "test:motion": "npm run build && node scripts/selection-motion.browser.mjs",
    "bench": "vitest bench --run",
    "bench:browser": "node bench/browser.mjs",
    "bench:profile": "node bench/profile.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.63.0",
    "svelte": "^5.28.1",
    "svelte-check": "^4.1.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0"
  }
}
