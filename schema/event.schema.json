{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chrisbuilds.github.io/ai-timeline/schema/event.schema.json",
  "title": "AI Timeline event",
  "description": "One event on the AI Timeline. Each event lives in events/<year>/<id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "date",
    "summary",
    "category",
    "sources",
    "importance"
  ],
  "$defs": {
    "date": {
      "description": "YYYY, YYYY-MM or YYYY-MM-DD. The format sets the precision.",
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}){0,2}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "confidence",
        "rationale",
        "evidence"
      ],
      "properties": {
        "rating": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assessed_at",
        "rubric_version",
        "status",
        "reviewer",
        "rationale",
        "dimensions",
        "comparisons",
        "questions",
        "review_after",
        "review_triggers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        },
        "assessed_at": {
          "type": "string",
          "format": "date"
        },
        "rubric_version": {
          "const": "v2"
        },
        "status": {
          "enum": [
            "accepted",
            "provisional"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 3
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "influence",
            "adoption",
            "capability",
            "society"
          ],
          "properties": {
            "influence": {
              "$ref": "#/$defs/dimension"
            },
            "adoption": {
              "$ref": "#/$defs/dimension"
            },
            "capability": {
              "$ref": "#/$defs/dimension"
            },
            "society": {
              "$ref": "#/$defs/dimension"
            }
          }
        },
        "comparisons": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rationale"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/eventId"
              },
              "rationale": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "review_after": {
          "type": "string",
          "format": "date"
        },
        "review_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "overview_reason": {
          "type": "string",
          "minLength": 20
        },
        "override": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "override_reason": {
          "type": "string",
          "minLength": 20
        },
        "override_review_after": {
          "type": "string",
          "format": "date"
        }
      },
      "dependentRequired": {
        "override": [
          "override_reason",
          "override_review_after"
        ]
      }
    }
  },
  "properties": {
    "id": {
      "$ref": "#/$defs/eventId",
      "description": "Date plus a short slug, matching the file name, e.g. 2024-09-12-openai-o1."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "date": {
      "$ref": "#/$defs/date"
    },
    "end_date": {
      "$ref": "#/$defs/date",
      "description": "For events that span time, such as an AI winter."
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 280,
      "description": "One sentence shown on the card."
    },
    "description": {
      "type": "string",
      "description": "Shown in the detail panel. Supports *italic*, **bold**, `code`, [links](https://...), lists, > quotes, {citation needed} and {note: ...}. See CONTRIBUTING.md."
    },
    "category": {
      "enum": [
        "research",
        "model release",
        "product",
        "company and funding",
        "policy and regulation",
        "safety and security incident",
        "hardware and compute",
        "benchmark milestone",
        "open source",
        "culture and society",
        "misinformation"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "people": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sources": {
      "description": "Proof the event happened. Primary source first.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title",
          "publisher",
          "accessed"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "archived_url": {
            "type": "string",
            "format": "uri",
            "description": "Wayback Machine snapshot, used if the original disappears."
          }
        }
      }
    },
    "artifacts": {
      "description": "Things the event produced: the paper, repo, model card, demo.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "url",
          "title"
        ],
        "properties": {
          "type": {
            "enum": [
              "paper",
              "repo",
              "model card",
              "video",
              "dataset",
              "post",
              "image"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "related": {
      "description": "At most 3 direct, source-stated links. See CLAUDE.md.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "relation"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/eventId"
          },
          "relation": {
            "enum": [
              "builds_on",
              "responds_to",
              "supersedes"
            ]
          },
          "source": {
            "type": "string",
            "format": "uri",
            "description": "Where the link is stated."
          }
        }
      }
    },
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability",
            "adoption",
            "impact",
            "culture"
          ],
          "properties": {
            "capability": {
              "$ref": "#/$defs/rating"
            },
            "adoption": {
              "$ref": "#/$defs/rating"
            },
            "impact": {
              "$ref": "#/$defs/rating"
            },
            "culture": {
              "$ref": "#/$defs/rating"
            }
          }
        },
        "override": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "override_reason": {
          "type": "string",
          "minLength": 10
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rubric_version",
            "migrated_at"
          ],
          "properties": {
            "rubric_version": {
              "const": "v1"
            },
            "migrated_at": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "current": {
          "type": "string"
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        },
        "override_review_after": {
          "type": "string",
          "format": "date"
        }
      },
      "dependentRequired": {
        "override": [
          "rubric",
          "override_reason"
        ],
        "assessments": [
          "current"
        ],
        "current": [
          "assessments"
        ],
        "legacy": [
          "rubric"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "override"
            ],
            "not": {
              "required": [
                "legacy"
              ],
              "properties": {
                "legacy": {}
              }
            },
            "properties": {
              "override": {},
              "legacy": {}
            }
          },
          "then": {
            "required": [
              "override_review_after"
            ],
            "properties": {
              "override_review_after": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "rubric": {},
              "assessments": {}
            },
            "required": [
              "rubric",
              "assessments"
            ]
          },
          "then": {
            "properties": {
              "legacy": {}
            },
            "required": [
              "legacy"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "rubric"
          ],
          "properties": {
            "rubric": {}
          }
        },
        {
          "required": [
            "current",
            "assessments"
          ],
          "properties": {
            "current": {},
            "assessments": {}
          }
        }
      ]
    },
    "aliases": {
      "description": "Ids of duplicate events merged into this one.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventId"
      }
    },
    "disputed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "reason"
      ],
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "developing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "since",
        "recheck"
      ],
      "properties": {
        "since": {
          "type": "string",
          "format": "date"
        },
        "recheck": {
          "type": "string",
          "format": "date"
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "submitted_by": {
      "type": "string",
      "description": "GitHub handle of the submitter."
    },
    "issue": {
      "type": "integer",
      "minimum": 1,
      "description": "Canonical issue for this event."
    }
  }
}
